# Copy this to .env and fill in your local MySQL credentials
# On Railway, these are set automatically — you only need this locally.

DATABASE_URL=mysql://root:@localhost:3306/trip_splitter

# Or set individually:
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLUSER=newuser
# MYSQLPASSWORD=newpassword
# MYSQLDATABASE=trip_splitter
